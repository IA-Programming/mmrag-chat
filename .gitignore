# ---- SECRETS (public repo: never commit these) -------------------------------
.streamlit/secrets.toml
secrets.toml
.env
.env.*
!.env.example
.envrc
*.pem
*.key

# ---- models, builds, bundles (frozen assets live in GitHub Releases, not git) --
*.gguf
*.litertlm
*.safetensors
*.bin
*.so
*.so.*
*.tar.gz
/build/
/dist/
/bundle/_cache/
/runtime/
/models/

# ---- runtime scratch (Streamlit Cloud disk is ephemeral anyway) --------------
/tmp/
.cache/
*.log
/logs/

# ---- dev experiments: ledger summaries are committed, raw dumps are not -------
/experiments/_raw/
/datasets/_scratch/

# ---- Python / tooling -------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.hypothesis/

# ---- editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store

# NOTE: do NOT use Git LFS in this repo. Community Cloud fails to clone
# repositories that use LFS. Datasets must be small plain-git files (<= 50 MB
# total), and models ship as release assets.
