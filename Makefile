# Command contract (see docs/DEVELOPMENT.md). Everything runs from the repo root.
PY      ?= python
COMPOSE ?= docker compose -f docker/compose.cap.yml

.PHONY: setup lock lint fmt type test apptest test-int test-mem eval audit secretscan build-llama dataset run run-fake check

setup:
	$(PY) -m pip install -r requirements.txt -r requirements-dev.txt

lock:            ## re-resolve the full runtime lock for Python 3.11 / Debian 11
	grep -v '^-c' requirements.txt > /tmp/mmrag-req.txt
	uv pip compile /tmp/mmrag-req.txt --python-version 3.11 --python-platform x86_64-manylinux_2_31 --no-header --no-annotate -o /tmp/mmrag-lock.txt
	( echo "# Full transitive lock of the runtime set (Python 3.11, manylinux_2_31 / Debian 11)."; \
	  echo "# Generated by: make lock   (uv pip compile requirements.txt). Do not edit by hand."; \
	  cat /tmp/mmrag-lock.txt ) > constraints.txt

lint:
	ruff check . && ruff format --check .

fmt:
	ruff check --fix . && ruff format .

type:
	mypy core app

test:
	pytest -m "not needs_runtime and not memory and not eval" -q

apptest:
	pytest tests/apptest -q

test-int:        ## needs a built runtime (tools/llama/build_llama.py) and models (tools/fetch_models.py)
	pytest -m needs_runtime -q

test-mem:        ## runs inside the 2.7 GB / 2-core capped emulator
	$(COMPOSE) run --rm cap pytest -m memory -q

eval:
	$(PY) -m tools.eval.run --matrix tools/eval/matrix.yaml

audit:
	pip-audit -r requirements.txt

secretscan:
	pytest tests/unit/test_secretscan.py -q

build-llama:
	$(PY) -m tools.llama.build_llama

dataset:
	$(PY) -m tools.dataset.generate --seed 7 --out datasets/synth_v1

run:
	streamlit run streamlit_app.py

run-fake:        ## UI against the fake llama-server (no models needed)
	MMRAG_RUNTIME=fake streamlit run streamlit_app.py

check: lint type test apptest secretscan
