# =============================================================================
# secrets.toml.example  -  key NAMES only, never values.
#
#   Local use : copy to .streamlit/secrets.toml (that file is git-ignored)
#   Cloud use : paste the filled-in contents into
#               Community Cloud -> your app -> Settings -> Secrets
#   NEVER commit a real secrets.toml.
#
# EVERY key below is OPTIONAL. The core app (index, retrieve, chat with the
# local frozen models, playground, explorer, logs) needs NO secrets.
# Unset or empty values mean "use the documented default" (docs/DATA_AND_INTEGRATIONS.md).
#
# DEVELOPMENT-ONLY credentials (HF_TOKEN, GEMINI_API_KEY used by tools/ and the
# eval runner) are provided as environment variables in the dev session / a
# git-ignored .env file. They are NOT part of the deployed app.
# =============================================================================

[gemini]                     # optional cloud fallback generator (FR-030), OpenAI-compatible endpoint
api_key  = ""                # a Google AI Studio key. If empty, testers may paste their own (session-only).
model    = ""                # model id exactly as returned by the provider's models list
base_url = ""                # default: https://generativelanguage.googleapis.com/v1beta/openai/

[app]
enable_gemini_fallback = ""  # "true" | "false"   (default false)
ui_mode                = ""  # "navigation" | "tabs"   (default per EXP-UI-01 outcome)
log_level              = ""  # DEBUG | INFO | WARNING | ERROR   (default INFO)
memory_cap_mb          = ""  # integer; default 2700 (Community Cloud ceiling); set lower to test
bundle_base_url        = ""  # override release base URL (forks hosting their own bundle)
